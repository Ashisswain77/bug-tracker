# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# JWT — use two DIFFERENT random secrets, at least 32 characters each.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations with a unit: s, m, h or d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie SameSite policy: strict | lax | none
# Use "none" only when the client and API are on different sites (forces Secure).
COOKIE_SAME_SITE=strict
